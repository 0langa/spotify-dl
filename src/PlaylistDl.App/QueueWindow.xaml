<Window x:Class="PlaylistDl.App.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download queue" Height="520" Width="760" MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="#111318">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Pending jobs" FontSize="17" FontWeight="SemiBold"
               Foreground="White" Margin="0,0,0,8" />

    <ListView Grid.Row="1" x:Name="JobsList" Background="#171A21" Foreground="#E7EBF2"
              BorderBrush="#303642" SelectionMode="Single">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Position}" />
          <GridViewColumn Header="Source" Width="250" DisplayMemberBinding="{Binding Name}" />
          <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding TypeLabel}" />
          <GridViewColumn Header="Tracks" Width="70" DisplayMemberBinding="{Binding TrackLabel}" />
          <GridViewColumn Header="Output" Width="230" DisplayMemberBinding="{Binding OutputDirectory}" />
        </GridView>
      </ListView.View>
    </ListView>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
      <Button x:Name="MoveUpButton" Content="Move up" Width="90" Margin="0,0,8,0" Click="MoveUpButton_Click" />
      <Button x:Name="MoveDownButton" Content="Move down" Width="100" Margin="0,0,8,0" Click="MoveDownButton_Click" />
      <Button x:Name="RemoveButton" Content="Remove" Width="90" Margin="0,0,8,0" Click="RemoveButton_Click" />
      <Button x:Name="ClearButton" Content="Clear queue" Width="110" Click="ClearButton_Click" />
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,18,0,0">
      <TextBlock x:Name="ReportTitle" Text="Last queue run" FontSize="15" FontWeight="SemiBold"
                 Foreground="White" Margin="0,0,0,6" Visibility="Collapsed" />
      <ListView x:Name="ReportList" Height="120" Background="#171A21" Foreground="#E7EBF2"
                BorderBrush="#303642" Visibility="Collapsed">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="Source" Width="250" DisplayMemberBinding="{Binding Name}" />
            <GridViewColumn Header="Result" Width="180" DisplayMemberBinding="{Binding Outcome}" />
            <GridViewColumn Header="Detail" Width="270" DisplayMemberBinding="{Binding Detail}" />
          </GridView>
        </ListView.View>
      </ListView>
    </StackPanel>

    <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
      <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="#AEB6C5"
                 VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True" Click="CloseButton_Click" />
    </DockPanel>
  </Grid>
</Window>
